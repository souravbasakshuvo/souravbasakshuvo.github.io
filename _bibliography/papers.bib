@article{hasan2025transfusionnet,
  author       = {Hasan*, Md. Najib and Shuvo*, Sourav Basak and Ankon*, Md Mahadi Hasan and Raju, S.M. Taslim Uddin and Siddique†, Nazmul},
  annotation   = {* Contributed equally as co-first authors},
  title        = {TransfusionNet: Framework for cervical cancer detection using deep learning with multi-level fusion},
  journal      = {Results in Engineering},
  volume       = {28},
  pages        = {107174},
  year         = {2025},
  month        = {December},
  issn         = {2590-1230},
  doi          = {10.1016/j.rineng.2025.107174},
  url          = {https://www.sciencedirect.com/science/article/pii/S2590123025032293},
  publisher    = {Elsevier},
  abbr         = {Res. Eng.},
  bibtex_show  = {true},
  selected     = {true},
  dimensions   = {true},
  html         = {https://www.sciencedirect.com/science/article/pii/S2590123025032293},
  pdf          = {https://www.sciencedirect.com/science/article/pii/S2590123025032293/pdfft?md5=1c14579dc923b67e0c6b1b64892df13c&pid=1-s2.0-S2590123025032293-main.pdf},
  code         = {https://github.com/souravbasakshuvo/TransFusionNet},
  abstract     = {This paper presents a hybrid deep learning model, TransfusionNet, comprising VGG19, ResNet50, and ViT with fusion for early detection of cervical cancer. An improved medical image preprocessing technique combining contrast-limited adaptive histogram equalization (CLAHE), Laplacian sharpening, bilateral filtering, and unsharp masking has been applied to enhance image quality. An early-layer feature fusion strategy was used to enhance feature diversity and improve decision-making, unlike conventional methods that fuse only at final layers. The fusion strategy combines features from VGG19, ResNet50, and ViT at multiple stages using concatenation and element-wise addition, allowing integration of detailed and high-level information across different levels. Two separate transition blocks were used to align VGG19 and ResNet50 outputs at different layers. TransfusionNet is trained and tested on the publicly available SIPaKMeD dataset, containing 4,049 images of five classes. TransfusionNet is also verified on Herlev and LCPSI datasets. The five-fold cross-validation was employed to mitigate overfitting and enhance model's robustness and generalizability. TransfusionNet demonstrates promising results for early cervical cancer detection, achieving state-of-the-art performance on the SIPaKMeD dataset. For batch size 128, TransfusionNet achieved an average accuracy of 99.40\%, an F1-score of 99.36\%, sensitivity of 99.25\%, and Cohen's Kappa of 99.67\% across the five folds. On the SIPaKMeD dataset, the proposed model outperformed the best-performing model by 3.77\% among the cited models. On the Herlev and LCPSI datasets, TransfusionNet surpassed the top-performing methods by 6.50\% and 1.22\% in accuracy, respectively. Future work will focus on validating the model on larger and more diverse datasets. The source code is available at https://github.com/souravbasakshuvo/TransFusionNet.},
  preview      = {transfusionnet_architecture.jpg},
}

@INPROCEEDINGS{shuvo2025molecular,
  author       = {Shuvo, Sourav Basak and Hossain, Sraboni and Redhila, Shaira Afra and Bose†, Urmi},
  title        = {Exploring Common Molecular Interactions across Multiple Cancers to Identify Potential Therapeutic Targets and Drug Candidates},
  booktitle    = {2025 7th International Conference on Electrical Information and Communication Technology (EICT)},
  year         = {2025},
  pages        = {1--6},
  month        = {December},
  doi          = {10.1109/EICT68394.2025.11355627},
  publisher    = {IEEE},
  address      = {Khulna, Bangladesh},
  isbn         = {979-8-3315-9392-6},
  abbr         = {EICT},
  bibtex_show  = {true},
  selected     = {true},
  dimensions   = {true},
  html         = {https://ieeexplore.ieee.org/document/11355627},
  abstract     = {Bioinformatics interprets biological data, especially genomics, to reveal shared genetic and molecular traits across cancers. Background research demonstrates that lung, cervical, liver, and prostate cancers share a significant number of biochemical and genetic traits. To conduct this study, we collected gene expression datasets: GSE19188 (lung cancer), GSE14520 (liver cancer), GSE46602 (prostate cancer), and GSE63514 (cervical cancer) from the Gene Expression Omnibus (GEO) database hosted by NCBI. The GEO2R tool was used for initial preprocessing, filtering, and identification of differentially expressed genes (DEGs). A total of 39 common DEGs shared across all four cancers were identified, from which 10 hub genes (PIK3R1, EZH2, ECT2, KPNA2, CCNB1, AURKA, CLU, TOP2A, BUB1B, ETS2) were selected based on degree centrality within the protein-protein interaction (PPI) network. To understand the biological relevance of these genes, gene ontology (GO), pathway enrichment, and heatmap analysis were performed. Additionally, regulatory and interaction networks were constructed, including the PPI network, TF-gene regulatory network, gene-miRNA interaction network, and protein-chemical interaction network, based on the hub genes. This network-based analysis revealed 15 key miRNAs and 17 transcription factors (TFs) as major regulatory components. Finally, potential therapeutic drug candidates were predicted through drug enrichment analysis using Enrichr, by examining their interactions with the key hub genes. In future, we aim to apply molecular docking and simulation techniques using plant-derived compounds to develop a unified therapeutic strategy targeting all four cancers.},
  preview      = {eict2025_molecular.jpg},
}

@INPROCEEDINGS{shuvo2024gallbladder,
  author       = {Shuvo, Sourav Basak and Chowdhury†, Mostafa Zaman},
  title        = {Classification of Gallbladder Cancer Using Average Ensemble Learning},
  booktitle    = {2024 6th International Conference on Electrical Engineering and Information \& Communication Technology (ICEEICT)},
  year         = {2024},
  pages        = {1450--1455},
  doi          = {10.1109/ICEEICT62016.2024.10534480},
  publisher    = {IEEE},
  address      = {Dhaka, Bangladesh},
  month        = {May},
  issn         = {2769-5700},
  abbr         = {ICEEICT},
  bibtex_show  = {true},
  selected     = {true},
  dimensions   = {true},
  abstract     = {Gallbladder cancer is a highly challenging malignancy within the field of oncology, distinguished by its diagnosis at an advanced stage and its restricted rates of survival. Gallbladder cancer classification from ultrasound images is a very difficult task due to poor image quality and speckle artifact. We suggest employing an ensemble of well-known Convolutional Neural Network models, such as VGG16, VGG19, XceptionNet, and ResNet50, to evaluate their effectiveness in differentiating between normal, benign, and malignant gall bladder conditions. As a result, the ensemble deep learning model significantly enhances the accuracy of classification.},
  html         = {https://ieeexplore.ieee.org/document/10534480},
  preview      = {iceeict2024_gallbladder.png},
}
