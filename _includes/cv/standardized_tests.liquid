{% comment %}
  Renderer for Standardized Tests section entries.
  Expected fields: name, date, highlights
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div style="display:flex; justify-content:space-between; align-items:baseline;">
        <strong>{{ entry.name }}</strong>
        {% if entry.date %}
          <span style="font-size:0.88em; color:var(--global-text-color-light); white-space:nowrap; margin-left:1em;">{{ entry.date }}</span>
        {% endif %}
      </div>
      {% if entry.highlights %}
        <ul class="items">
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
