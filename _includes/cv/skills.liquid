{% comment %}
  Skills renderer — two-column table: bold category left, items text right.
  Supports new category/items format and legacy name/keywords format.
{% endcomment %}

<div class="card-text font-weight-light">
  <table style="width:100%; border-collapse:collapse;">
    {% for entry in entries %}
      {% if entry.category %}
        <tr style="vertical-align:top;">
          <td style="font-weight:600; white-space:nowrap; padding:3px 1.5em 3px 0; width:1%;">{{ entry.category }}</td>
          <td style="padding:3px 0;">{{ entry.items }}</td>
        </tr>
      {% else %}
        <tr style="vertical-align:top;">
          <td style="font-weight:600; white-space:nowrap; padding:3px 1.5em 3px 0; width:1%;">
            {% if entry.icon %}<i class="{{ entry.icon }}"></i> {% endif %}{{ entry.name }}
          </td>
          <td style="padding:3px 0;">
            {% if entry.keywords %}{{ entry.keywords | join: ', ' }}{% endif %}
          </td>
        </tr>
      {% endif %}
    {% endfor %}
  </table>
</div>
